# Build output
/build/
/dist/
/dep/
/plugin.dylib
/plugin.so
/plugin.dll
*.o
*.d
*.a
*.dSYM/

# Scratch directory the VCV screenshot renderer uses
/tools/.rackshot/

# Test binaries and rendered audio
/tests/*/test_*
!/tests/*/test_*.cpp
/tests/*/render_*
!/tests/*/render_*.cpp
/tests/*/out/

__pycache__/
*.pyc

.DS_Store

# The browser mock embeds Rack's fonts as base64, read from an installed copy of
# Rack (panelkit/preview.py). A machine without Rack generates a valid but
# different file, so this one generated artefact is local-only.
/tools/previews/*.html

# NOTE: everything else panelkit generates is deliberately NOT ignored.
# res/*.svg, src/PanelTheme.hpp, src/*/Panel.hpp and tools/previews/*.png are
# committed, because the VCV Library build machines compile this repo without
# running Python. They are still outputs -- edit tools/panels/<Module>.py.
