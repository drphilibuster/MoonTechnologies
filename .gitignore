# Build output
/build/
/dist/
/dep/
/plugin.dylib
/plugin.so
/plugin.dll
*.o
*.d
*.a
*.dSYM/

# Scratch directory the VCV screenshot renderer uses
/tools/.rackshot/

# Test binaries and rendered audio
/tests/*/test_*
!/tests/*/test_*.cpp
!/tests/*/test_*.py
/tests/*/render_*
!/tests/*/render_*.cpp
/tests/*/out/

__pycache__/
*.pyc

.DS_Store

# The browser mock embeds Rack's fonts as base64, read from an installed copy of
# Rack (panelkit/preview.py). A machine without Rack generates a valid but
# different file, so this one generated artefact is local-only.
/tools/previews/*.html

# NOTE: everything else panelkit generates is deliberately NOT ignored.
# res/*.svg, src/PanelTheme.hpp, src/*/Panel.hpp and tools/previews/*.png are
# committed, because the VCV Library build machines compile this repo without
# running Python. They are still outputs -- edit tools/panels/<Module>.py.

# Ensoniq DP/4 EPROM images (Apportionment loads them at runtime; they are
# Ensoniq's and must never be committed). tests/Apportionment reads them from
# $DP4_ROMS, outside the repository.
*DP4*.bin
*dp4*.bin

# Alesis MIDIverb / MIDIFEX EPROM images (Rebate loads them at runtime; they are
# Alesis's and must never be committed). tests/Rebate reads them from
# $MIDIVERB_ROMS, outside the repository.
*MVOP*
*MVOBJ*
*mvop*
*mvobj*
*MIDIFEX*.bin
*MIDIFEX*.Bin
*MIDIFEX*.BIN
*MIDIVerb*.BIN
*MIDIVerb*.bin
*midiverb*.bin
*midifex*.bin

# Access Virus OS images (Contagion loads them at runtime; they are Access's and must
# never be committed). tests/Contagion reads them from $VIRUS_ROMS, outside the repository.
*Virus*.bin
*Virus*.BIN
*virus*.bin
*am29f040b*

# Lexicon PCM 70 firmware images (Depreciation loads them at runtime; they are
# Lexicon's and must never be committed). tests/Depreciation reads them from
# $PCM70_ROMS, outside the repository. Only their SHA-256 hashes are in the source.
*PCM70*.bin
*PCM70*.BIN
*PCM-70*.bin
*PCM-70*.BIN
*pcm70*.bin
*U62*.bin
*U62*.BIN
*U95*.bin
*U95*.BIN
*U67*.bin
*U67*.BIN
0c515e08.bin
8203b1df.bin
# ...nor Lexicon's factory SysEx banks or any recording/IR of the machine.
*PCM*70*.syx

# Third-party PIC firmware (no licence stated): loaded at runtime, never committed
*varimodequantizer*

# Nord Lead OS images and flash dumps (Nordic Banking loads them at runtime; they are
# Clavia's and must never be committed). tests/NordicBanking reads them from $NL2X_ROMS.
*nord_lead*.bin
*nord-lead*.bin
*Nord*Lead*.bin
*NORD*.BIN
*nl2x*.bin
# ...nor Clavia's factory programs (SysEx).
*Nord*Lead*.syx
*nord*lead*.syx
*nl2x*.syx

# Illustrator templates: generated from the specs by `make art`, never committed
/art/templates/

# scratch copies of art being imported
/art/work/
